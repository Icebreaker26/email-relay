# ── Seguridad ────────────────────────────────────────────────
# Clave compartida entre Railway y este relay.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RELAY_SECRET=

# ── SMTP (cPanel) ────────────────────────────────────────────
SMTP_HOST=mail.tudominio.com
SMTP_PORT=465
SMTP_USER=correo@tudominio.com
SMTP_PASS=
SMTP_FROM="Nombre Remitente <correo@tudominio.com>"

# ── Railway ──────────────────────────────────────────────────
# Token: railway.app > avatar > Account Settings > Tokens > New Token
RAILWAY_TOKEN=
# Service ID: railway.app > proyecto > servicio backend > Settings > Service ID
RAILWAY_SERVICE_ID=

# ── Backend ──────────────────────────────────────────────────
# URL del backend en Railway (para reintentar emails al arrancar)
BACKEND_URL=https://tu-backend.up.railway.app

# ── Puerto local (opcional) ──────────────────────────────────
PORT=3099
